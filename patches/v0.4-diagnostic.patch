+local function CompletionistMapV04_JoinFlags(markerID, flags)
+  local result = {}
+  for _, flag in ipairs(flags) do
+    local ok, hasFlag = pcall(function()
+      return Map.MarkerHasAnyFlag(markerID, {flag})
+    end)
+    if ok and hasFlag then
+      result[#result + 1] = tostring(flag)
+    end
+  end
+  if #result == 0 then
+    return "<none>"
+  end
+  return table.concat(result, ",")
+end
+local function CompletionistMapV04_DumpScalars(prefix, value)
+  local ok, err = pcall(function()
+    for key, fieldValue in pairs(value) do
+      local fieldType = type(fieldValue)
+      if fieldType == "string" or fieldType == "number" or fieldType == "boolean" then
+        print(prefix .. " key=" .. tostring(key) .. " type=" .. fieldType .. " value=" .. tostring(fieldValue))
+      end
+    end
+  end)
+  if not ok then
+    print(prefix .. " scalarDumpError=" .. tostring(err))
+  end
+end
