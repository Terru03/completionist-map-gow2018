+-- Completionist Map v0.3 diagnostic.
+-- Read-only probe for Alfheim marker metadata. No icons are created and no
+-- marker/progression state is changed.
+local function CompletionistMap_StateName(state)
+  if state == tweaks.eTokenState.kDiscovered then
+    return "kDiscovered"
+  elseif state == tweaks.eTokenState.kDiscoveredButLocked then
+    return "kDiscoveredButLocked"
+  elseif state == tweaks.eTokenState.kUndiscovered then
+    return "kUndiscovered"
+  end
+  return tostring(state)
+end
+
+local completionistMapKnownFlags = {
+  consts.COMPASS_MARKER_TYPE_VENDOR,
+  consts.COMPASS_MARKER_TYPE_VENDOR_NO_TRACK,
+  consts.COMPASS_MARKER_TYPE_FAST_TRAVEL,
+  consts.COMPASS_MARKER_TYPE_FAST_TRAVEL_NO_TRACK,
+  consts.COMPASS_MARKER_TYPE_DOCK_POINT,
+  consts.COMPASS_MARKER_TYPE_AREA_ENTRANCE,
+  consts.COMPASS_MARKER_TYPE_CHISEL_ENTRANCE,
+  consts.COMPASS_MARKER_TYPE_CHISEL_ENTRANCE_NO_TRACK,
+  consts.COMPASS_MARKER_TYPE_FIGHT_LOCATION,
+  consts.COMPASS_MARKER_TYPE_FIGHT_LOCATION_NO_TRACK,
+  consts.COMPASS_MARKER_TYPE_INFO_ONLY,
+  consts.COMPASS_MARKER_TYPE_VALKYRIE,
+  "PrimaryQuest",
+  "SecondaryQuest",
+  "RadiusType"
+}
+
+local function CompletionistMap_JoinKnownFlags(markerID)
+  local result = {}
+  for _, flag in ipairs(completionistMapKnownFlags) do
+    local ok, hasFlag = pcall(function()
+      return Map.MarkerHasAnyFlag(markerID, {flag})
+    end)
+    if ok and hasFlag then
+      result[#result + 1] = tostring(flag)
+    end
+  end
+  if #result == 0 then
+    return "<none>"
+  end
+  return table.concat(result, ",")
+end
+
+local function CompletionistMap_DumpScalarFields(prefix, value)
+  local ok, err = pcall(function()
+    for key, fieldValue in pairs(value) do
+      local fieldType = type(fieldValue)
+      if fieldType == "string" or fieldType == "number" or fieldType == "boolean" then
+        print(prefix .. " key=" .. tostring(key) .. " type=" .. fieldType .. " value=" .. tostring(fieldValue))
+      end
+    end
+  end)
+  if not ok then
+    print(prefix .. " scalarDumpError=" .. tostring(err))
+  end
+end
